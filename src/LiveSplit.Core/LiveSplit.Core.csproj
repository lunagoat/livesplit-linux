<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LiveSplit</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);SYSLIB0014;SYSLIB0013;SYSLIB0011;CA1416;CS0618;NU1701</NoWarn>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RootPath)/linux/native/liblivesplit_core.so" Link="liblivesplit_core.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RootPath)/linux/native/liblivesplit_core.so')" />
    <None Include="$(RootPath)/linux/native/libwin32shim.so" Link="libwin32shim.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RootPath)/linux/native/libwin32shim.so')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(LibPath)/SpeedrunComSharp/src/SpeedrunComSharp/SpeedrunComSharp.csproj" />
    <ProjectReference Include="$(RootPath)/linux/LiveSplit.Drawing/LiveSplit.Drawing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Codaxy.Xlio" Version="1.0.0" />
    <PackageReference Include="GitInfo" Version="3.6.0" PrivateAssets="all" />
    <PackageReference Include="IrcDotNet" Version="0.7.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.8" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Formats.Nrbf" Version="10.0.8" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.8" />
    <PackageReference Include="WebSocketSharp" Version="1.0.3-rc11" />
  </ItemGroup>

  <Target Name="WriteGitInfo" DependsOnTargets="GitInfo" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)/Updates/GitInfo" />

    <PropertyGroup>
      <GitDescribe>$(GitBaseTag)-$(GitCommits)-g$(GitCommit)</GitDescribe>
      <GitDescribe Condition="'$(GitIsDirty)' == 'true'">$(_Describe)-dirty</GitDescribe>
    </PropertyGroup>

    <WriteLinesToFile File="$(MSBuildProjectDirectory)/Updates/GitInfo/version.txt" Lines="$(GitDescribe)" Overwrite="true" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/Updates/GitInfo/branch.txt" Lines="$(GitBranch)" Overwrite="true" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/Updates/GitInfo/revision.txt" Lines="$(GitCommit)" Overwrite="true" />
  </Target>

</Project>
