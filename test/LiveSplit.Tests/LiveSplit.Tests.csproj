<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB0014;CA1416;CS0618;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Depends on LiveSplit.TotalPlaytime, which is not ported yet. -->
    <Compile Remove="TimeFormatTests/DaysTimeFormatterTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcPath)/LiveSplit.Core/LiveSplit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
