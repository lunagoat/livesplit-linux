<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LiveSplit</RootNamespace>
    <AssemblyName>LiveSplit</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1416;CS0618;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcPath)/LiveSplit.Core/LiveSplit.Core.csproj" />
  </ItemGroup>

  <!--
    Components.

    Every component that builds on net10.0 is listed here. Adding a component is one line: add its csproj as a
    ComponentProject. The project is built before the app (it is not referenced as an assembly) and its output
    (artifacts/build/Components, see components/Directory.Build.props) is copied into <app dir>/Components, where
    LiveSplit.Services.ComponentCatalog finds it through Core's ComponentManager (assembly scan).

    A plain ProjectReference to a component works as well: the app also scans its own directory for assemblies that
    carry a [ComponentFactory] attribute (use that for statically linked components).
  -->
  <ItemGroup Label="Components">
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.AutoSplittingRuntime/src/LiveSplit.AutoSplittingRuntime/LiveSplit.AutoSplittingRuntime.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.BlankSpace/src/LiveSplit.BlankSpace/LiveSplit.BlankSpace.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.ComparisonTime/src/LiveSplit.ComparisonTime/LiveSplit.ComparisonTime.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.Counter/src/LiveSplit.Counter/LiveSplit.Counter.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.CurrentComparison/src/LiveSplit.CurrentComparison/LiveSplit.CurrentComparison.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.Delta/src/LiveSplit.Delta/LiveSplit.Delta.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.DetailedTimer/src/LiveSplit.DetailedTimer/LiveSplit.DetailedTimer.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.Graph/src/LiveSplit.Graph/LiveSplit.Graph.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.HotkeyIndicator/src/LiveSplit.HotkeyIndicator/LiveSplit.HotkeyIndicator.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.ManualGameTime/src/LiveSplit.ManualGameTime/LiveSplit.ManualGameTime.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.PossibleTimeSave/src/LiveSplit.PossibleTimeSave/LiveSplit.PossibleTimeSave.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.PreviousSegment/src/LiveSplit.PreviousSegment/LiveSplit.PreviousSegment.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.Racetime/src/LiveSplit.Racetime/LiveSplit.Racetime.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.RunPrediction/src/LiveSplit.RunPrediction/LiveSplit.RunPrediction.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.ScriptableAutoSplit/src/LiveSplit.ScriptableAutoSplit/LiveSplit.ScriptableAutoSplit.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.Sound/src/LiveSplit.Sound/LiveSplit.Sound.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.Splits/src/LiveSplit.Splits/LiveSplit.Splits.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.Subsplits/src/LiveSplit.Subsplits/LiveSplit.Subsplits.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.SumOfBest/src/LiveSplit.SumOfBest/LiveSplit.SumOfBest.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.Text/src/LiveSplit.Text/LiveSplit.Text.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.TheRun/src/LiveSplit.TheRun/LiveSplit.TheRun.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.Timer/src/LiveSplit.Timer/LiveSplit.Timer.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.Title/src/LiveSplit.Title/LiveSplit.Title.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.TotalPlaytime/src/LiveSplit.TotalPlaytime/LiveSplit.TotalPlaytime.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.Video/src/LiveSplit.Video/LiveSplit.Video.csproj" />
    <ComponentProject Include="$(ComponentsPath)/LiveSplit.WorldRecord/src/LiveSplit.WorldRecord/LiveSplit.WorldRecord.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="@(ComponentProject)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(ResourcesPath)/Icon.png" Link="Resources/Icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RootPath)/linux/native/libasr_capi.so" Link="libasr_capi.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RootPath)/linux/native/libasr_capi.so')" />
    <None Include="$(RootPath)/linux/native/liblivesplit_core.so" Link="liblivesplit_core.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RootPath)/linux/native/liblivesplit_core.so')" />
    <EmbeddedResource Include="$(SrcPath)/LiveSplit.View/Resources/DefaultLayout.lsl" LogicalName="DefaultLayout.lsl" />
    <AvaloniaResource Include="$(ResourcesPath)/Icon.png" Link="Assets/Icon.png" />
    <Content Include="$(SrcPath)/LiveSplit.Core/Localization/Locales/*.json" Link="Localization/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyComponentsToOutput" AfterTargets="Build" Condition="'@(ComponentProject)' != ''">
    <ItemGroup>
      <_BuiltComponentFile Include="$(BuildPath)/Components/*.dll;$(ArtifactsPath)/build/Components/*.dll" Exclude="$(BuildPath)/Components/LiveSplit.Core.dll;$(BuildPath)/Components/LiveSplit.Drawing.dll;$(BuildPath)/Components/SpeedrunComSharp.dll;$(ArtifactsPath)/build/Components/LiveSplit.Core.dll;$(ArtifactsPath)/build/Components/LiveSplit.Drawing.dll;$(ArtifactsPath)/build/Components/SpeedrunComSharp.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_BuiltComponentFile)" DestinationFolder="$(OutDir)Components" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyComponentsToPublish" AfterTargets="Publish" Condition="'@(ComponentProject)' != ''">
    <ItemGroup>
      <_BuiltComponentFilePublish Include="$(BuildPath)/Components/*.dll;$(ArtifactsPath)/build/Components/*.dll" Exclude="$(BuildPath)/Components/LiveSplit.Core.dll;$(BuildPath)/Components/LiveSplit.Drawing.dll;$(BuildPath)/Components/SpeedrunComSharp.dll;$(ArtifactsPath)/build/Components/LiveSplit.Core.dll;$(ArtifactsPath)/build/Components/LiveSplit.Drawing.dll;$(ArtifactsPath)/build/Components/SpeedrunComSharp.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_BuiltComponentFilePublish)" DestinationFolder="$(PublishDir)Components" SkipUnchangedFiles="true" />
  </Target>

</Project>
